{
  "name": "autoclick",
  "version": "1.0.0",
  "description": "AutoClick - 手机投屏与控制软件",
  "main": "dist/main/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cp src/main/screen-mirror/bridge.mjs dist/main/main/screen-mirror/bridge.mjs && wait-on http://localhost:5173 && NODE_ENV=development electron .",
    "build:renderer": "vite build && sed -i '' 's/ crossorigin=\"[^\"]*\"//g; s/ crossorigin//g' dist/renderer/index.html",
    "build:main": "tsc -p tsconfig.main.json && cp src/main/screen-mirror/bridge.mjs dist/main/main/screen-mirror/bridge.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@langchain/openai": "^1.5.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-tinyh264": "^2.1.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.2",
    "tailwind-merge": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.30",
    "uuid": "^14.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.autoclick.app",
    "productName": "AutoClick",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "asar": false,
    "mac": {
      "target": "dmg",
      "icon": "resources/macos/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/windows/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/linux/icons"
    }
  }
}
